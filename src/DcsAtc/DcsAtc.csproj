<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>DcsAtc</AssemblyName>
    <InvariantGlobalization>true</InvariantGlobalization>
    <UseWindowsForms>true</UseWindowsForms>
    <!-- LA24: version from the installer script (one place), otherwise the log shows 1.0.0.0 -->
    <Version>$([System.Text.RegularExpressions.Regex]::Match($([System.IO.File]::ReadAllText('$(MSBuildThisFileDirectory)..\..\installer\DcsAtc.iss')), '#define AppVer "([^"]+)"').Groups[1].Value)</Version>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="NAudio.WinMM" Version="2.2.1" />
    <EmbeddedResource Include="..\..\charts\caucasus.jsonc" LogicalName="caucasus.jsonc" />
  </ItemGroup>

</Project>
